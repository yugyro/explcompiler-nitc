Grammar

    0 $accept: Program $end

    1 Program: Declarations slist

    2 Declarations: DECL decllist ENDDECL
    3             | DECL ENDDECL

    4 decllist: decllist decla
    5         | decla

    6 decla: Type Varlist ';'

    7 Type: INT
    8     | STR

    9 Varlist: Varlist ',' Varitem
   10        | Varitem

   11 Varitem: ID '[' NUM ']'
   12        | ID

   13 slist: slist stmt
   14      | stmt

   15 stmt: inputstmt
   16     | outputstmt
   17     | assignstmt
   18     | ifstmt
   19     | whilestmt
   20     | BREAK ';'
   21     | CONTINUE ';'

   22 inputstmt: READ '(' Lvalue ')' ';'

   23 outputstmt: WRITE '(' E ')' ';'

   24 assignstmt: Lvalue '=' E ';'

   25 Lvalue: ID
   26       | ID '[' E ']'

   27 ifstmt: IF '(' E ')' THEN slist ELSE slist ENDIF ';'
   28       | IF '(' E ')' THEN slist ENDIF ';'

   29 whilestmt: WHILE '(' E ')' DO slist ENDWHILE ';'

   30 E: E '+' E
   31  | E '-' E
   32  | E '*' E
   33  | E '/' E
   34  | E '<' E
   35  | E '>' E
   36  | E LE E
   37  | E GE E
   38  | E NE E
   39  | E EQOP E
   40  | '(' E ')'
   41  | NUM
   42  | STRCONST
   43  | Lvalue


